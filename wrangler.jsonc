{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cooking-bot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "previews": {}
}
